    powercfg -delete a0200000-0000-0000-0000-000000000002 >nul 2>&1
    powercfg -import "C:\VieX Studio\AOZ PowerPlan\Backup\ActivePlan_Backup.pow" a0200000-0000-0000-0000-000000000002 >nul 2>&1
