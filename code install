:SetDefaultHigh
powercfg -setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
if errorlevel 1 (
    powercfg -duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
    powercfg -setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul 2>&1
)
echo.
echo  [+] Đã kích hoạt High Performance PowerPlan!
pause
goto :MainMenu

:OptimizeSystem
cls
color 0B
echo.
echo ==========================================================
echo          [ TỐI ƯU HÓA KERNEL, BCD VÀ DỊCH VỤ ]
echo ==========================================================
echo.
echo  [⏳] Đang cấu hình BCD (Boot Configuration Data)...
bcdedit /set disabledynamictick yes >nul 2>&1
bcdedit /set useplatformclock No >nul 2>&1
bcdedit /set useplatformtick Yes >nul 2>&1

echo  [⏳] Đang cấu hình Kernel ^& Multimedia Class Scheduler (MMCSS)...
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "SystemResponsiveness" /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "NetworkThrottlingIndex" /t REG_DWORD /d 4294967295 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "GPU Priority" /t REG_DWORD /d 8 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Priority" /t REG_DWORD /d 6 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Scheduling Category" /t REG_SZ /d "High" /f >nul 2>&1

echo  [⏳] Đang tắt các dịch vụ không cần thiết (Debloat)...
sc config "SysMain" start= disabled >nul 2>&1
sc stop "SysMain" >nul 2>&1
sc config "DiagTrack" start= disabled >nul 2>&1
sc stop "DiagTrack" >nul 2>&1
sc config "dmwappushservice" start= disabled >nul 2>&1
sc stop "dmwappushservice" >nul 2>&1

echo [%DATE% %TIME%] Optimize System (Kernel/BCD/Debloat): Success >> "C:\VieX Studio\Logs\VieX Log.txt"

echo.
color 0A
echo ==========================================================
echo            [ TỐI ƯU HÓA HỆ THỐNG THÀNH CÔNG ]
echo ==========================================================
echo.
echo  [*] Yêu cầu khởi động lại máy để áp dụng hoàn toàn!
echo.
pause
goto :MainMenu

:RestoreSystem
cls
color 0B
echo.
echo ==========================================================
echo          [ KHÔI PHỤC KERNEL, BCD VÀ DỊCH VỤ ]
echo ==========================================================
echo.
echo  [⏳] Đang khôi phục cấu hình BCD...
bcdedit /deletevalue disabledynamictick >nul 2>&1
bcdedit /deletevalue useplatformclock >nul 2>&1
bcdedit /deletevalue useplatformtick >nul 2>&1

echo  [⏳] Đang khôi phục Kernel ^& MMCSS...
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "SystemResponsiveness" /t REG_DWORD /d 20 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "NetworkThrottlingIndex" /t REG_DWORD /d 10 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "GPU Priority" /t REG_DWORD /d 8 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Priority" /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games" /v "Scheduling Category" /t REG_SZ /d "Medium" /f >nul 2>&1

echo  [⏳] Đang khôi phục các dịch vụ (SysMain, Telemetry)...
sc config "SysMain" start= auto >nul 2>&1
sc start "SysMain" >nul 2>&1
sc config "DiagTrack" start= auto >nul 2>&1
sc start "DiagTrack" >nul 2>&1
sc config "dmwappushservice" start= delayed-auto >nul 2>&1

echo [%DATE% %TIME%] Restore System (Kernel/BCD/Debloat): Success >> "C:\VieX Studio\Logs\VieX Log.txt"

echo.
color 0A
echo ==========================================================
echo             [ KHÔI PHỤC HỆ THỐNG THÀNH CÔNG ]
echo ==========================================================
echo.
echo  [*] Yêu cầu khởi động lại máy để áp dụng hoàn toàn!
echo.
pause
goto :MainMenu

