:ExecuteAOZDeploy
cls
color 0B
echo.
echo ==========================================================
echo               [ CÀI ĐẶT AOZ POWERPLAN ]
echo ==========================================================
echo.

set "AOZ_GUID=a0200000-0000-0000-0000-000000000001"
set "SUB_PROC=54533251-82be-4824-96c1-79b60d74076e"
set "SUB_PCIE=501a4d13-42af-4429-9e56-e32f20df8d20"
set "SUB_DISK=0012ee47-9041-4b5d-9b77-535fba8b1442"

echo  [⏳] Đang xác thực scheme và xử lý cấu hình cũ...
set "ACTIVE_GUID="
for /f "usebackq tokens=*" %%A in (`powershell -NoProfile -Command "([regex]::Match((powercfg /getactivescheme), '[a-fA-F0-9-]{36}')).Value"`) do set "ACTIVE_GUID=%%A"

if /i "%ACTIVE_GUID%"=="%AOZ_GUID%" (
    powercfg -setactive 381b4222-f694-41f0-9685-ff5bb260df2e >nul 2>&1
)
powercfg -delete %AOZ_GUID% >nul 2>&1

echo  [⏳] Đang khởi tạo Scheme nền tảng...
if exist "%~dp0AOZ_Power.pow" (
    powercfg -import "%~dp0AOZ_Power.pow" %AOZ_GUID% >nul 2>&1
) else (
    powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61 %AOZ_GUID% >nul 2>&1
    if errorlevel 1 powercfg -duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c %AOZ_GUID% >nul 2>&1
    if errorlevel 1 powercfg -duplicatescheme 381b4222-f694-41f0-9685-ff5bb260df2e %AOZ_GUID% >nul 2>&1
    if errorlevel 1 powercfg -duplicatescheme %ACTIVE_GUID% %AOZ_GUID% >nul 2>&1
)
powercfg -changename %AOZ_GUID% "AOZ PowerPlan" "VieX Studio Ultra Low Latency Performance Profile" >nul 2>&1

echo  [⏳] Đang phân tích phần cứng qua CIM Engine...
set "IS_LAPTOP=0"
for /f "usebackq tokens=*" %%A in (`powershell -NoProfile -Command "if ((Get-CimInstance -ClassName Win32_Battery -ErrorAction SilentlyContinue) -or ((Get-CimInstance -ClassName Win32_SystemEnclosure -ErrorAction SilentlyContinue).ChassisTypes -match '^(8|9|10|11|12|14|18|21|30|31|32)$')) { '1' } else { '0' }"`) do set "IS_LAPTOP=%%A"

if "%IS_LAPTOP%"=="1" (
    echo  [+] Thiết bị: Laptop ^| Áp dụng cấu hình cân bằng nhiệt...
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 3668d56e-2c6e-46cb-8832-be0689119f26 10
    powercfg -setdcvalueindex %AOZ_GUID% %SUB_PROC% 3668d56e-2c6e-46cb-8832-be0689119f26 20
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 0cc5b647-c36e-463e-bbd6-77047160b7fb 80
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PCIE% ee12f906-d277-404b-b6da-e5fa1a576df5 1
    echo [%DATE% %TIME%] AOZ Deploy: Laptop Profile >> "C:\VieX Studio\Logs\VieX Log.txt"
) else (
    echo  [+] Thiết bị: Desktop PC ^| Áp dụng cấu hình hiệu năng tối đa...
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 3668d56e-2c6e-46cb-8832-be0689119f26 0
    powercfg -setdcvalueindex %AOZ_GUID% %SUB_PROC% 3668d56e-2c6e-46cb-8832-be0689119f26 0
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 0cc5b647-c36e-463e-bbd6-77047160b7fb 100
    powercfg -setacvalueindex %AOZ_GUID% %SUB_PCIE% ee12f906-d277-404b-b6da-e5fa1a576df5 0
    echo [%DATE% %TIME%] AOZ Deploy: Desktop Profile >> "C:\VieX Studio\Logs\VieX Log.txt"
)

powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 89ba4f42-e282-4c92-83b2-f01991a0022f 100
powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% bc5038f7-23e0-4960-96da-33abaf5935ec 100
powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 94d3a615-a899-4ac5-ae2b-e4d8f6343b57 1
powercfg -setacvalueindex %AOZ_GUID% %SUB_PROC% 7f24e389-dc4f-4532-9c0d-66bd6d846236 0
powercfg -setacvalueindex %AOZ_GUID% %SUB_DISK% 6738e2c4-e8a5-4a42-e16a-e040e769756e 0

powercfg -setactive %AOZ_GUID%
powercfg -export "C:\VieX Studio\AOZ PowerPlan\AOZ_Power.pow" %AOZ_GUID% >nul 2>&1

echo.
color 0A
echo ==========================================================
echo            [ KÍCH HOẠT AOZ POWERPLAN THÀNH CÔNG ]
echo ==========================================================
echo.
pause
goto :MainMenu

:BackupCurrentPlan
cls
color 0B
echo.
echo ==========================================================
echo              [ SAO LƯU POWERPLAN HIỆN TẠI ]
echo ==========================================================
echo.

set "CURR_GUID="
for /f "usebackq tokens=*" %%A in (`powershell -NoProfile -Command "([regex]::Match((powercfg /getactivescheme), '[a-fA-F0-9-]{36}')).Value"`) do set "CURR_GUID=%%A"

if "%CURR_GUID%"=="" (
    echo  [X] Không thể trích xuất GUID của PowerPlan hiện tại.
    pause
    goto :MainMenu
)

set "BACKUP_GUID=a0200000-0000-0000-0000-000000000002"
if /i "%CURR_GUID%"=="%BACKUP_GUID%" (
    powercfg -setactive 381b4222-f694-41f0-9685-ff5bb260df2e >nul 2>&1
)
powercfg -delete %BACKUP_GUID% >nul 2>&1

powercfg -duplicatescheme %CURR_GUID% %BACKUP_GUID% >nul 2>&1
powercfg -changename %BACKUP_GUID% "VieX Restore PowerPlan" "Ban sao luu khoi phuc tao boi VieX Studio" >nul 2>&1
powercfg -export "C:\VieX Studio\AOZ PowerPlan\Backup\ActivePlan_Backup.pow" %CURR_GUID% >nul 2>&1
echo [%DATE% %TIME%] Backup PowerPlan (%CURR_GUID%): Success >> "C:\VieX Studio\Logs\VieX Log.txt"

echo.
color 0A
echo ==========================================================
echo          [ ĐÃ TẠO BẢN SAO LƯU POWERPLAN THÀNH CÔNG ]
echo ==========================================================
echo.
echo  [+] GUID đã lưu: %CURR_GUID%
echo  [+] Đường dẫn: C:\VieX Studio\AOZ PowerPlan\Backup\ActivePlan_Backup.pow
echo.
pause
goto :MainMenu

